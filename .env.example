# Telegram delivery credentials.
# 1. Create a bot with @BotFather on Telegram -> you get the bot token.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# See README.md for the full walkthrough.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe
TELEGRAM_CHAT_ID=123456789

# Optional: set to "true" to compute + log picks but NOT send Telegram messages
# (useful for local dry runs). Anything other than "true" sends normally.
DRY_RUN=false
